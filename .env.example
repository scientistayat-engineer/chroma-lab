# Groq API: used only for LLM answer generation.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Current Groq quickstart model. You can swap this for another model
# available in your Groq Console.
GROQ_MODEL=openai/gpt-oss-20b

# FREE local embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base

# Chroma Cloud — only needed if you run migrate_to_chroma_cloud.py to copy
# your local collection to a hosted Chroma Cloud database. Get these from
# https://trychroma.com (sign up, then `chroma login` / the Cloud dashboard).
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=64
